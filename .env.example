# 既定値は docs/specs/08-architecture.md §4 と一致させること。
# しきい値をコードに直書きしない（Q-2 未確定のため）。

# --- フェーズ ---
PHASE_SIMILARITY_MIN=30
PHASE_DRSA_MIN=60
# ENABLED_ATTRIBUTES と PHASE_DRSA_MIN は連動する。片方だけ変えない。
# 3個構成にしたら PHASE_DRSA_MIN=180。
ENABLED_ATTRIBUTES=preference_match,rating_affinity

# --- 品質ゲート（DRSA 昇格の追加条件・03-phases.md §3.3）---
DRSA_MIN_RULES=3
DRSA_MIN_GAMMA=0.5
DRSA_MIN_COVERAGE=0.5

# --- 実験（参加者内ランダム化・09-research-design.md）---
EXPERIMENT_SPLIT_ENABLED=true
EXPERIMENT_ARM_A=DRSA
EXPERIMENT_ARM_B=COVERAGE

# --- 評価 ---
RATING_SCALE_DEFAULT=4
HIGH_RATING_RATIO=0.75
LOW_RATING_RATIO=0.25

# --- 戦略 ---
W_COVERAGE=0.5
W_INTEREST=0.5
SIMILARITY_NEIGHBORS=20
SIMILARITY_SHRINKAGE=5
SIMILARITY_COVERAGE_FLOOR=0.2
DRSA_COVERAGE_FLOOR=0.2
MAX_PER_CATEGORY=0

# --- DRSA ---
DRSA_CONSISTENCY=0.8
MIN_SUPPORT=5

# --- 性能・キャッシュ ---
SNAPSHOT_TTL_SEC=300
RULE_CACHE_TTL_SEC=300
RESPONSE_BUDGET_MS=600

# --- 運用 ---
# production で /demo を無効化し、OPS_TOKEN 未設定時は /ops/* も無効化する（11-deployment.md D-3・D-4）。
APP_ENV=development
LOG_RAW_REQUEST=false
LOG_LEVEL=info
# /ops/* の保護。production では必須（11-deployment.md D-4）。本番は Secret Manager 経由。
OPS_TOKEN=
# 未設定ならパッケージ版を使う。本番はコミット SHA を入れる（11-deployment.md X-6）。
ENGINE_VERSION=

# --- 戦略の選択（ADR 0007）---
# auto | coverage | random
# auto = フェーズ判定に従う（段3・4 未結線のため現状は必ず COVERAGE）
# random は下限ベースライン。APP_ENV=production では auto に落とす
STRATEGY=auto

# --- データ取得（ADR 0002 採用・案A' 読み取り専用プロキシ）---
# 空なら取得を試みず COVERAGE 固定で動く。
# 本番で未設定のままだと SIMILARITY / DRSA が一度も動かない（11-deployment.md D-6）。
READONLY_PROXY_URL=
# 読み取り専用の鍵。書き込み可能な鍵を入れてはならない。
READONLY_PROXY_KEY=
# 1テーブルあたり。更新間隔（SNAPSHOT_TTL_SEC=300）を食い潰さない値。
READONLY_PROXY_TIMEOUT_SEC=20
# 対象イベント。空なら直近のリクエストの event_id を使う。
SNAPSHOT_EVENT_ID=
